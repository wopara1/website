# Copy to .env.local. Names only; never commit real values.

# Resend API key for the contact form (server only). Without it the form returns a "not configured" error.
RESEND_API_KEY=

# Public site URL used for metadata. Defaults to https://www.paradoxequity.com when unset.
NEXT_PUBLIC_SITE_URL=

# Optional. Sender address for the contact form; must be on a domain verified in Resend.
# Defaults to contact@mail.paradoxequity.com.
CONTACT_FROM_EMAIL=

# Test only: point the Resend SDK at a local mock server. Never set in production.
RESEND_BASE_URL=
